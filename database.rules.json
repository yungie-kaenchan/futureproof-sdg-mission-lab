{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "progress": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "tokens": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "consents": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "teams": {
      "$tid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('teams/' + $tid + '/members/' + auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)",
        "integrityScore": { ".write": "root.child('admins').child(auth.uid).val() === true" }
      }
    },

    "scenarios": {
      ".read": "auth != null",
      "$sid": {
        ".write": "auth != null && (!data.exists() || data.child('lockedBy').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "missions": {
      ".read": "auth != null",
      "$mid": {
        ".write": "auth != null"
      }
    },

    "decisions": {
      "$mid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null"
      }
    },

    "artifacts": {
      "$tid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "rubricScores": {
      "$tid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "reflections": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "fieldMentor": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "hall": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "moderation": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null"
    },

    "audit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
