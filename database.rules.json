{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'teacher')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",

        "tokens": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
          "balance": { ".write": "auth.token.role === 'admin'" },
          "earned":  { ".write": "auth.token.role === 'admin'" },
          "spent":   { ".write": "auth.token.role === 'admin'" },
          "ledger":  { ".write": "auth.token.role === 'admin'" }
        }
      }
    },

    "consents": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "teams": {
      "$tid": {
        ".read":  "auth != null",
        ".write": "auth != null && (root.child('teams/' + $tid + '/members/' + auth.uid).exists() || auth.token.role === 'teacher' || auth.token.role === 'admin')",
        "integrityScore": { ".write": "auth.token.role === 'admin'" }
      }
    },

    "scenarios": {
      ".read":  "auth != null",
      "$sid": {
        ".write": "auth != null && (!data.exists() || data.child('lockedBy').val() === auth.uid || auth.token.role === 'admin')"
      }
    },

    "missions": {
      ".read":  "auth != null",
      "$mid": {
        ".write": "auth != null"
      }
    },

    "reflections": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'teacher')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "fieldMentor": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'teacher')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "hall": {
      ".read":  true,
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'teacher')"
    },

    "moderation": {
      ".read":  "auth != null && (auth.token.role === 'admin' || auth.token.role === 'teacher')",
      ".write": "auth != null"
    },

    "audit": {
      ".read":  "auth != null && auth.token.role === 'admin'",
      ".write": false
    },

    "config": {
      ".read":  "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'"
    }
  }
}
