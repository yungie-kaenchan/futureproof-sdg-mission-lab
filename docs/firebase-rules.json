{
  "_comment": "FUTUREPROOF — RTDB security rules. Paste the object below (WITHOUT this _comment line) into Firebase Console → Realtime Database → Rules → Publish. Model: a learner can touch only their own data; an administrator (admins/<uid> === true) has full read/write across all learners; config is world-readable so the journey can read mission on/off + demo flags, but only an admin can change it.",
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "root.child('admins').child(auth.uid).val() === true"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "consents": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "progress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "reflections": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "decisions": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "$mission": {
        ".write": "auth != null"
      }
    },

    "tokens": {
      "$team": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "config": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    }
  }
}
