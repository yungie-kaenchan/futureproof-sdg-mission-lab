rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default: deny everything.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatars — the avatar.js code uses a flat path: `avatars/<uid>_v<n>.png`.
    // Users can write files whose name starts with their own uid; anyone signed in can read.
    // Image-only; max 4 MB.
    match /avatars/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && file.matches('^' + request.auth.uid + '_v[0-9]+\\.png$')
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Generated stylized avatars (post-Stability.ai). Read-only for the owner + teachers.
    match /avatars-generated/{file} {
      allow read:  if request.auth != null;
      allow write: if false;   // written by Cloud Function only
    }

    // Voice recordings (reflections + pitch-capsule narration).
    // Audio-only; max 20 MB; user-owned.
    match /reflections/{uid}/{file} {
      allow read:  if request.auth != null
                   && (request.auth.uid == uid
                       || request.auth.token.role == 'admin'
                       || request.auth.token.role == 'teacher');
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    match /pitch-capsules/{uid}/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType.matches('audio/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Hall of Excellence — public read for curated artifacts; writes via Cloud Function.
    match /hall/{tid}/{file} {
      allow read:  if true;
      allow write: if false;
    }

    // Admin uploads (rubric updates, scenario seeds).
    match /admin/{file} {
      allow read:  if request.auth != null
                   && (request.auth.token.role == 'admin'
                       || request.auth.token.role == 'teacher');
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
